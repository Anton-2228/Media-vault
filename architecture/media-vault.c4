specification {
  element actor {
    style {
      shape person
    }
  }
  element system
  element service
  element database {
    style {
      shape storage
    }
  }
  element queue {
    style {
      shape queue
    }
  }
}

model {
  clients = actor 'Сервисы-пользователи' {
    description 'Регистрируемые сервисы (Telegram, телефон и т.д.), которые отправляют медиа в хранилище и получают их обратно'
    technology 'Любой язык'
  }

  admin = actor 'Администратор' {
    description 'Рассматривает заявки на регистрацию сервисов-пользователей, блокирует сервисы-пользователи и перевыпускает их секреты'
  }

  mediaVault = system 'Media Vault' {
    description 'Централизованное хранилище медиа из разных источников. Разворачивается в Kubernetes. Наружу публикуется только gateway, остальные сервисы живут в сети кластера и доверяют друг другу'

    gateway = service 'Gateway' {
      description 'Единая точка входа для сервисов-пользователей. Своего кода нет, только конфигурация. Терминирует TLS, маршрутизирует, ограничивает частоту запросов и размер тела, держит таймауты, проксирует web socket. Проверку токенов делегирует через ext_authz: bearer-token - сервису авторизации, одноразовый токен - сервису доступа к файлам, и добавляет к запросу заголовки из их ответов'
      technology 'Envoy Gateway'
    }

    processing = service 'Сервис обработки файлов' {
      description 'Внутренний воркер. По id операции обрабатывает загруженные файлы, перемещает их в нужную директорию, подменяет и удаляет файлы (в т.ч. списком, атомарно), формирует и изменяет метаинформацию. Перед подменой и удалением прячет прежние данные в корзину операции и чистит ее после завершения. Шагом операции обновляет индекс метаинформации в postgres, при первом запуске на существующем хранилище строит индекс сканированием. По команде сервиса доступа откатывает свои шаги в обратном порядке. Все шаги идемпотентны, задание из кафки может прийти повторно; задания выполняются в пуле воркеров, оффсет подтверждается после перехода состояния. Фиксирует изменения в операции, событий для подписок сам не публикует'
      technology 'Python, FastAPI'
    }

    access = service 'Сервис доступа к файлам' {
      description 'Единая точка взаимодействия сервисов-пользователей с файлами. Любое взаимодействие с хранилищем, включая чтение и запрос метаинформации, - операция. Создает и ведет операции (сага с машиной состояний: у каждого состояния один владелец, переходы через compare-and-set): проверяет выполнимость действия (политики доступа пока нет), следит, чтобы над файлом шла только одна изменяющая операция, резервирует имена файлов, выдает и проверяет одноразовые токены, ставит задания воркеру, фоновыми задачами Celery следит за крайними сроками и ретраями, при ошибке решает об откате: командует воркеру откатить файловые шаги и откатывает свои изменения в postgres, после успешного завершения публикует событие об изменении и командует очистку корзины операции. Файловое хранилище сам не трогает. Отдает метаинформацию и поуровневый список источников'
      technology 'Python, FastAPI'
    }

    auth = service 'Сервис авторизации' {
      description 'Принимает заявки на регистрацию, после одобрения администратором выдает сервису-пользователю идентификатор и секрет, выдает и проверяет bearer-token-ы, блокирует и отзывает регистрации. Проверяет учетные данные администраторов'
      technology 'Python, FastAPI'
    }

    adminUi = service 'Сервис администрирования' {
      description 'Веб-интерфейс для администратора: список заявок на регистрацию, одобрение и отклонение, блокировка, отзыв регистрации и перевыпуск секретов. React-приложение плюс backend на FastAPI, который отдает его как статику и проксирует запросы в сервис авторизации. Логики не содержит'
      technology 'React, Python, FastAPI'
    }

    subscriptions = service 'Сервис подписок' {
      description 'Принимает подписки с фильтрами (по сервису-пользователю - по id или по названию, по источнику, по типу файла), получает события об изменениях и формирует уведомления для подписанных сервисов-пользователей. При отзыве регистрации уведомляет подписчиков отозванного, их подписки не трогает'
      technology 'Python, FastAPI'
    }

    notifier = service 'Сервис-нотифайер' {
      description 'Держит web socket соединения сервисов-пользователей (gateway их только проксирует) и отправляет в них уведомления, считает доставленным только подтвержденное. Закрывает соединения заблокированных и отозванных. Ведет таблицу уведомлений и политику ретраев (периодическая задача Celery по времени следующей попытки): интервал между попытками каждый раз удваивается, общий срок доставки - неделя, после чего уведомление считается недоставленным'
      technology 'Python, FastAPI'
    }

    wrapper = service 'Сервис-обертка над базой знаний' {
      description 'База знаний = файловое хранилище + база данных. Один сервис, единственная точка доступа и к файловому хранилищу, и к базе данных. Два независимых модуля: файловое хранилище (seafile) и база данных (PostgreSQL), каждый прячет конкретную реализацию за собственным интерфейсом. Кроме CRUD дает транзакционные примитивы (одна транзакция = один эндпоинт): создать операцию с резервированием имени, compare-and-set состояния, шаг с проверкой состояния и т.д.; решений не принимает. Внутренние сервисы считает доверенными и не авторизует'
      technology 'Python, FastAPI, SQLAlchemy'
    }

    prometheus = service 'Prometheus' {
      description 'Собирает метрики со всех внутренних сервисов через их эндпоинты /metrics, а также метрики PostgreSQL и Kafka через экспортеры'
      technology 'Prometheus'
    }

    grafana = service 'Grafana' {
      description 'Дашборды и алерты по метрикам из Prometheus: застрявшие откаты, недоставленные уведомления, блокировки, ошибки, отставание кафки. Единственный интерфейс мониторинга для администратора'
      technology 'Grafana'
    }

    postgres = database 'База данных' {
      description 'Заявки на регистрацию, сервисы-пользователи, администраторы, операции (состояние, версия, крайний срок) и их шаги, резервирование имен файлов (уникальное ограничение источник + имя, единственный арбитр занятости имени), индекс метаинформации для фильтров и история изменений файлов (оба производные от json файлов), подписки, уведомления и политика ретраев'
      technology 'PostgreSQL'
    }

    redis = database 'Redis' {
      description 'Брокер и бэкенд результатов Celery для фоновых задач сервисов (крайние сроки операций, ретраи отката и очистки, ретраи уведомлений, служебные задачи авторизации). Данных системы не хранит, источник истины для задач - PostgreSQL'
      technology 'Redis'
    }

    fileStorage = database 'Файловое хранилище' {
      description 'Файлы (file_storage/), json с метаинформацией (metadata/, <имя файла с расширением>.json, разделы system и custom; custom разбит на пространства по идентификаторам сервисов-пользователей, в system - авторство ключей и история изменений файла; источник истины о метаинформации), директория временного хранения и корзины операций (trash/<id операции>/)'
      technology 'Seafile, может быть вне закрытой сети'
    }

    access -> subscriptions 'события об изменениях после успешного завершения операции' {
      technology 'Apache Kafka'
    }
    subscriptions -> notifier 'уведомления' {
      technology 'Apache Kafka'
    }
    gateway -> auth 'ext_authz: проверка bearer-token на каждом запросе; маршруты: заявка на регистрацию, статус заявки, получение bearer-token, отзыв регистрации'
    adminUi -> auth 'вход администратора, список заявок, одобрение и отклонение, блокировка, отзыв регистрации, перевыпуск секрета'
    auth -> subscriptions 'отзыв регистрации: удалить подписки отозванного и уведомить его подписчиков'
    auth -> notifier 'закрыть web socket соединения заблокированного или отозванного, отменить недоставленные уведомления отозванного'
    gateway -> access 'ext_authz на загрузке и скачивании: проверка одноразового токена (в ответ заголовки с id операции, путем, типом действия, для загрузки - размером и хешем); маршруты: создание операций (в т.ч. удаление), запросы по id операции, метаинформация, список источников'
    access -> wrapper 'ведет операции (переходы состояний через compare-and-set), резервирует имена файлов, хранит одноразовые токены, ищет файлы и источники по индексу метаинформации и читает json, откатывает свои изменения в postgres'
    access -> processing 'задания на обработку, удаление, откат шагов и очистку корзины с id операции (партиция по id операции)' {
      technology 'Apache Kafka'
    }
    processing -> access 'результаты выполнения заданий и откатов' {
      technology 'Apache Kafka'
    }
    gateway -> wrapper 'проксирует загрузку и скачивание файлов, путь и id операции в заголовках от ext_authz'
    wrapper -> access 'результат передачи файла по id операции: завершена (размер и хеш совпали) или оборвана'
    gateway -> subscriptions 'подписки на изменения'
    gateway -> notifier 'проксирует web socket соединения сервисов-пользователей с заголовками об идентификаторе и сроке токена' {
      technology 'WebSocket'
    }
    auth -> wrapper 'хранит заявки, сервисы-пользователи и администраторов'
    subscriptions -> wrapper 'хранит подписки'
    notifier -> wrapper 'хранит уведомления и политику ретраев'
    processing -> wrapper 'перемещает, подменяет и удаляет файлы, пишет метаинформацию, обновляет индекс метаинформации, работает с корзиной операции, откатывает свои шаги, фиксирует шаги и переводит состояния операции, которыми владеет'
    wrapper -> postgres 'ORM'
    wrapper -> fileStorage 'чтение и запись файлов, всегда по TLS с учетными данными seafile, известными только обертке' {
      technology 'HTTPS'
    }

    access -> redis 'Celery: проверка крайних сроков операций, ретраи отката и очистки корзины'
    notifier -> redis 'Celery: доставка уведомлений по времени следующей попытки, недельный срок'
    auth -> redis 'Celery: снятие блокировок, удаление старых заявок'
    processing -> redis 'Celery: одноразовая задача построения индекса при запуске'

    grafana -> prometheus 'запросы метрик, алерты'
    prometheus -> gateway 'сбор метрик'
    prometheus -> auth 'сбор метрик'
    prometheus -> access 'сбор метрик'
    prometheus -> processing 'сбор метрик'
    prometheus -> subscriptions 'сбор метрик'
    prometheus -> notifier 'сбор метрик'
    prometheus -> wrapper 'сбор метрик'
    prometheus -> adminUi 'сбор метрик'
    prometheus -> postgres 'сбор метрик через экспортер'
    prometheus -> redis 'сбор метрик Celery через экспортер'
  }

  clients -> gateway 'все запросы: заявка на регистрацию, авторизация, файлы, подписки' {
    technology 'HTTPS'
  }
  gateway -> clients 'уведомления от сервиса-нотифайера и подтверждения их получения' {
    technology 'WebSocket over TLS'
  }
  admin -> adminUi 'рассматривает заявки, управляет сервисами-пользователями' {
    technology 'HTTPS'
  }
  admin -> grafana 'смотрит дашборды, получает алерты' {
    technology 'HTTPS'
  }
}

views {
  view index {
    title 'Media Vault — контекст'
    include *
  }

  view overview of mediaVault {
    title 'Media Vault — общая архитектура'
    include *
    exclude prometheus -> *
  }

  view observability of mediaVault {
    title 'Media Vault — наблюдаемость'
    include admin, grafana, prometheus
    include prometheus -> *
    include admin -> grafana
  }
}
