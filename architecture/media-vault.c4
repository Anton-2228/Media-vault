specification {
  element actor {
    style {
      shape person
    }
  }
  element system
  element service
  element database {
    style {
      shape storage
    }
  }
  element queue {
    style {
      shape queue
    }
  }
}

model {
  clients = actor 'Сервисы-пользователи' {
    description 'Регистрируемые сервисы (Telegram, телефон и т.д.), которые отправляют медиа в хранилище и получают их обратно'
    technology 'Любой язык'
  }

  mediaVault = system 'Media Vault' {
    description 'Централизованное хранилище медиа из разных источников'

    gateway = service 'Gateway' {
      description 'Единая точка входа для сервисов-пользователей. Запрашивает проверку bearer-token у сервиса авторизации, перенаправляет запросы во внутренние сервисы и доставляет уведомления'
    }

    processing = service 'Сервис обработки файлов' {
      description 'Внутренний воркер. По заданиям обрабатывает загруженные файлы, перемещает их в нужную директорию, подменяет файлы, формирует и изменяет метаинформацию'
      technology 'Python'
    }

    access = service 'Сервис доступа к файлам' {
      description 'Единая точка взаимодействия сервисов-пользователей с файлами. Проверяет доступ, резервирует имена файлов, выдает и проверяет одноразовые токены, отдает метаинформацию, ставит задания воркеру'
      technology 'Python'
    }

    auth = service 'Сервис авторизации' {
      description 'Регистрирует сервисы-пользователи по мастер-ключу, выдает и проверяет bearer-token-ы'
      technology 'Python'
    }

    kafka = queue 'Kafka' {
      description 'Взаимодействие внутренних сервисов: топики сервиса обработки файлов, сервиса подписок и нотифайера'
      technology 'Apache Kafka'
    }

    subscriptions = service 'Сервис подписок' {
      description 'Принимает подписки с фильтрами, получает события об изменениях и формирует уведомления для подписанных сервисов-пользователей'
    }

    notifier = service 'Сервис-нотифайер' {
      description 'Отправляет уведомления сервисам-пользователям через gateway. Ведет таблицу уведомлений и политику ретраев: интервал между попытками каждый раз удваивается'
    }

    wrapper = service 'Сервис-обертка' {
      description 'Единственная точка доступа к файловому хранилищу и базе данных. Прячет конкретное хранилище за собственным интерфейсом'
      technology 'Python, FastAPI, SQLAlchemy'
    }

    postgres = database 'База данных' {
      description 'Сервисы-пользователи, резервирование имен файлов, журнал запросов, подписки, уведомления и политика ретраев'
      technology 'PostgreSQL'
    }

    fileStorage = database 'Файловое хранилище' {
      description 'Файлы (file_storage/), json с метаинформацией (metadata/) и директория временного хранения'
      technology 'Seafile'
    }

    processing -> kafka 'пишет события об изменениях в топик сервиса подписок'
    kafka -> subscriptions 'события об изменениях'
    subscriptions -> kafka 'пишет уведомления в топик нотифайера'
    kafka -> notifier 'уведомления'
    gateway -> auth 'регистрация, получение bearer-token, запрос на проверку bearer-token'
    gateway -> access 'все запросы по файлам и метаинформации, проверка одноразового токена'
    access -> wrapper 'резервирует имена файлов, хранит одноразовые токены, читает метаинформацию'
    access -> kafka 'пишет задания в топик сервиса обработки файлов'
    kafka -> processing 'задания на обработку'
    gateway -> wrapper 'загрузка и скачивание файлов по одноразовому токену'
    gateway -> subscriptions 'подписки на изменения'
    notifier -> gateway 'уведомления'
    auth -> wrapper 'хранит сервисы-пользователи'
    subscriptions -> wrapper 'хранит подписки'
    notifier -> wrapper 'хранит уведомления и политику ретраев'
    processing -> wrapper 'перемещает файлы, пишет метаинформацию и журнал'
    wrapper -> postgres 'ORM'
    wrapper -> fileStorage 'чтение и запись файлов'
  }

  clients -> gateway 'все запросы: авторизация, файлы, подписки'
  gateway -> clients 'уведомления'
}

views {
  view index {
    title 'Media Vault — контекст'
    include *
  }

  view overview of mediaVault {
    title 'Media Vault — общая архитектура'
    include *
  }
}
