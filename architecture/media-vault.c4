specification {
  element actor {
    style {
      shape person
    }
  }
  element system
  element service
  element database {
    style {
      shape storage
    }
  }
  element queue {
    style {
      shape queue
    }
  }
}

model {
  clients = actor 'Сервисы-пользователи' {
    description 'Регистрируемые сервисы (Telegram, телефон и т.д.), которые отправляют медиа в хранилище и получают их обратно'
    technology 'Любой язык'
  }

  admin = actor 'Администратор' {
    description 'Рассматривает заявки на регистрацию сервисов-пользователей, блокирует сервисы-пользователи и перевыпускает их секреты'
  }

  mediaVault = system 'Media Vault' {
    description 'Централизованное хранилище медиа из разных источников. Наружу публикуется только gateway, остальные сервисы живут в закрытой сети и доверяют друг другу'

    gateway = service 'Gateway' {
      description 'Единая точка входа для сервисов-пользователей. Терминирует TLS, ограничивает частоту запросов и размер тела. Запрашивает проверку bearer-token у сервиса авторизации, перенаправляет запросы во внутренние сервисы. Держит web socket соединения сервисов-пользователей и доставляет в них уведомления с подтверждением'
    }

    processing = service 'Сервис обработки файлов' {
      description 'Внутренний воркер. По id операции обрабатывает загруженные файлы, перемещает их в нужную директорию, подменяет файлы, формирует и изменяет метаинформацию. Шагом операции обновляет индекс метаинформации в postgres, при первом запуске на существующем хранилище строит индекс сканированием. По команде сервиса доступа откатывает свои шаги в обратном порядке. Фиксирует изменения в операции, событий для подписок сам не публикует'
      technology 'Python'
    }

    access = service 'Сервис доступа к файлам' {
      description 'Единая точка взаимодействия сервисов-пользователей с файлами. Создает и ведет операции (сага): проверяет выполнимость действия (политики доступа пока нет), резервирует имена файлов, выдает и проверяет одноразовые токены, ставит задания воркеру, при ошибке решает об откате: командует воркеру откатить файловые шаги и откатывает свои изменения в postgres, после успешного завершения публикует событие об изменении. Файловое хранилище сам не трогает. Отдает метаинформацию'
      technology 'Python'
    }

    auth = service 'Сервис авторизации' {
      description 'Принимает заявки на регистрацию, после одобрения администратором выдает сервису-пользователю идентификатор и секрет, выдает и проверяет bearer-token-ы. Проверяет учетные данные администраторов'
      technology 'Python'
    }

    adminUi = service 'Сервис администрирования' {
      description 'Frontend с веб-интерфейсом для администратора: список заявок на регистрацию, одобрение и отклонение, блокировка сервисов-пользователей и перевыпуск секретов. Логики не содержит, работает через API сервиса авторизации'
      technology 'Web UI'
    }

    subscriptions = service 'Сервис подписок' {
      description 'Принимает подписки с фильтрами, получает события об изменениях и формирует уведомления для подписанных сервисов-пользователей'
    }

    notifier = service 'Сервис-нотифайер' {
      description 'Отправляет уведомления сервисам-пользователям через gateway по web socket, считает доставленным только подтвержденное. Ведет таблицу уведомлений и политику ретраев: интервал между попытками каждый раз удваивается'
    }

    wrapper = service 'Сервис-обертка над базой знаний' {
      description 'База знаний = файловое хранилище + база данных. Один сервис, единственная точка доступа и к файловому хранилищу, и к базе данных. Два независимых модуля: файловое хранилище (seafile) и база данных (PostgreSQL), каждый прячет конкретную реализацию за собственным интерфейсом. Внутренние сервисы считает доверенными и не авторизует'
      technology 'Python, FastAPI, SQLAlchemy'
    }

    prometheus = service 'Prometheus' {
      description 'Собирает метрики со всех внутренних сервисов через их эндпоинты /metrics, а также метрики PostgreSQL и Kafka через экспортеры'
      technology 'Prometheus'
    }

    grafana = service 'Grafana' {
      description 'Дашборды и алерты по метрикам из Prometheus: застрявшие откаты, недоставленные уведомления, блокировки, ошибки, отставание кафки. Единственный интерфейс мониторинга для администратора'
      technology 'Grafana'
    }

    postgres = database 'База данных' {
      description 'Заявки на регистрацию, сервисы-пользователи, администраторы, операции, резервирование имен файлов, индекс метаинформации для фильтров (производный от json файлов), подписки, уведомления и политика ретраев'
      technology 'PostgreSQL'
    }

    fileStorage = database 'Файловое хранилище' {
      description 'Файлы (file_storage/), json с метаинформацией (metadata/, источник истины о метаинформации) и директория временного хранения'
      technology 'Seafile'
    }

    access -> subscriptions 'события об изменениях после успешного завершения операции' {
      technology 'Apache Kafka'
    }
    subscriptions -> notifier 'уведомления' {
      technology 'Apache Kafka'
    }
    gateway -> auth 'подача заявки на регистрацию, статус заявки, получение bearer-token, запрос на проверку bearer-token'
    adminUi -> auth 'вход администратора, список заявок, одобрение и отклонение, блокировка, перевыпуск секрета'
    gateway -> access 'создание операций, запросы по id операции, метаинформация, проверка одноразового токена (в ответ путь и тип действия из операции)'
    access -> wrapper 'ведет операции, резервирует имена файлов, хранит одноразовые токены, ищет файлы по индексу метаинформации и читает их json, откатывает свои изменения в postgres'
    access -> processing 'задания на обработку и на откат файловых шагов с id операции (партиция по id операции)' {
      technology 'Apache Kafka'
    }
    processing -> access 'результаты выполнения заданий и откатов' {
      technology 'Apache Kafka'
    }
    gateway -> wrapper 'загрузка и скачивание файлов по пути из операции'
    gateway -> subscriptions 'подписки на изменения'
    notifier -> gateway 'запрос на доставку уведомления по id сервиса-пользователя, в ответ результат доставки'
    auth -> wrapper 'хранит заявки, сервисы-пользователи и администраторов'
    subscriptions -> wrapper 'хранит подписки'
    notifier -> wrapper 'хранит уведомления и политику ретраев'
    processing -> wrapper 'перемещает и подменяет файлы, пишет метаинформацию, обновляет индекс метаинформации, откатывает свои шаги, фиксирует изменения в операции'
    wrapper -> postgres 'ORM'
    wrapper -> fileStorage 'чтение и запись файлов'

    grafana -> prometheus 'запросы метрик, алерты'
    prometheus -> gateway 'сбор метрик'
    prometheus -> auth 'сбор метрик'
    prometheus -> access 'сбор метрик'
    prometheus -> processing 'сбор метрик'
    prometheus -> subscriptions 'сбор метрик'
    prometheus -> notifier 'сбор метрик'
    prometheus -> wrapper 'сбор метрик'
    prometheus -> adminUi 'сбор метрик'
    prometheus -> postgres 'сбор метрик через экспортер'
  }

  clients -> gateway 'все запросы: заявка на регистрацию, авторизация, файлы, подписки' {
    technology 'HTTPS'
  }
  gateway -> clients 'уведомления и подтверждения их получения' {
    technology 'WebSocket over TLS'
  }
  admin -> adminUi 'рассматривает заявки, управляет сервисами-пользователями' {
    technology 'HTTPS'
  }
  admin -> grafana 'смотрит дашборды, получает алерты' {
    technology 'HTTPS'
  }
}

views {
  view index {
    title 'Media Vault — контекст'
    include *
  }

  view overview of mediaVault {
    title 'Media Vault — общая архитектура'
    include *
    exclude prometheus -> *
  }

  view observability of mediaVault {
    title 'Media Vault — наблюдаемость'
    include admin, grafana, prometheus
    include prometheus -> *
    include admin -> grafana
  }
}
